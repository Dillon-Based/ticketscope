{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SimulateAndCost",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy",
        "iam:GetContextKeysForPrincipalPolicy",
        "ce:Get*",
        "ce:List*",
        "ce:Describe*",
        "budgets:ViewBudget"
      ],
      "Resource": "*"
    }
  ]
}
