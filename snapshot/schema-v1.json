{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dillon-Based/ticketscope/snapshot/schema-v1.json",
  "title": "ticketscope corpus snapshot issue, schema v1",
  "description": "One line of a corpus snapshot (gzipped JSONL, one issue per line). Carries every field AD-6 names. Mirrors ticketscope.core.snapshot.SnapshotIssue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "url",
    "title",
    "body",
    "state",
    "state_reason",
    "created_at",
    "closed_at",
    "labels",
    "comments",
    "timeline"
  ],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string" },
    "body": { "type": ["string", "null"] },
    "state": { "enum": ["open", "closed"] },
    "state_reason": { "enum": ["completed", "not_planned", "duplicate", "reopened", null] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "closed_at": {
      "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author_association", "body", "created_at"],
        "properties": {
          "author_association": {
            "enum": [
              "OWNER",
              "MEMBER",
              "COLLABORATOR",
              "CONTRIBUTOR",
              "FIRST_TIME_CONTRIBUTOR",
              "FIRST_TIMER",
              "MANNEQUIN",
              "NONE"
            ]
          },
          "body": { "type": "string" },
          "created_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "timeline": {
      "description": "Timeline events, including marked_as_duplicate and cross-referenced or closing pull requests.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "created_at"],
        "properties": {
          "event": { "type": "string" },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "source_number": { "type": ["integer", "null"] },
          "source_url": { "type": ["string", "null"] },
          "source_is_pull_request": { "type": ["boolean", "null"] },
          "source_merged": { "type": ["boolean", "null"] }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "description": "RFC 3339, UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
